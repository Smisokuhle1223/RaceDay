@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }

<div class="rd-card p-5 text-center">
    <h2 class="rd-heading">Something went wrong</h2>
    <p class="text-muted">We hit a problem loading that page. Please try again, or head back to the home page.</p>
    <a class="btn btn-rd" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
