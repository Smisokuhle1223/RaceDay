@model EventDetail
@{
    ViewData["Title"] = "Categories";
}

<a asp-action="Events" class="text-decoration-none">&larr; Back to my events</a>
<h2 class="rd-heading mt-2 mb-3">Categories: @Model.EventName</h2>

@if (!Model.Categories.Any())
{
    <div class="rd-card p-4 text-muted mb-4">No categories yet. Add one below.</div>
}
else
{
    <div class="rd-card p-0 overflow-hidden mb-4">
        <table class="table mb-0 align-middle">
            <thead><tr><th>Category</th><th>Distance</th><th>Entry fee</th><th>Capacity</th><th>Enrolled</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model.Categories)
                {
                    <tr>
                        <td>@c.CategoryName</td>
                        <td>@c.DistanceKM km</td>
                        <td>R @c.EntryFee.ToString("0.00")</td>
                        <td>@c.MaxParticipants</td>
                        <td>@c.EnrolledCount</td>
                        <td class="text-end">
                            <form asp-action="DeleteCategory" method="post" onsubmit="return confirm('Remove this category?');">
                                <input type="hidden" name="id" value="@c.CategoryID" />
                                <input type="hidden" name="eventId" value="@Model.EventID" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="rd-card p-4">
    <h4 class="rd-heading">Add a category</h4>
    <form asp-action="AddCategory" method="post" class="row g-2 align-items-end">
        <input type="hidden" name="EventID" value="@Model.EventID" />
        <div class="col-md-3">
            <label class="form-label">Name</label>
            <input name="CategoryName" class="form-control" placeholder="e.g. 10km, Under 20, Senior" required />
        </div>
        <div class="col-md-2">
            <label class="form-label">Distance (km)</label>
            <input name="DistanceKM" type="number" step="0.1" min="0.1" class="form-control" required />
        </div>
        <div class="col-md-2">
            <label class="form-label">Capacity</label>
            <input name="MaxParticipants" type="number" min="1" value="100" class="form-control" required />
        </div>
        <div class="col-md-2">
            <label class="form-label">Entry fee (R)</label>
            <input name="EntryFee" type="number" step="0.01" min="0" value="0" class="form-control" required />
        </div>
        <div class="col-md-3 d-grid">
            <button type="submit" class="btn btn-rd">Add category</button>
        </div>
    </form>
</div>